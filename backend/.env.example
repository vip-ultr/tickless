# Tickless backend environment variables (copy to .env and fill)
# Shared secret the frontend must send in X-Tickless-Key header
TICKLESS_API_KEY=change-me-to-a-long-random-string

# Comma-separated allowed origins for CORS (frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,https://tickless.vercel.app

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Supabase (ad storage) - fill when wiring ads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ADS_BUCKET=ad-creatives

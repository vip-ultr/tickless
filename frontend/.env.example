# Frontend environment variables (copy to .env.local and fill)
# Base URL of the Tickless backend (FastAPI on Render).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional API key sent as X-Tickless-Key. Only needed when the backend
# has TICKLESS_API_KEY set. Leave blank for local dev.
NEXT_PUBLIC_API_KEY=

# Optional: turn on the YouTube cookie-state debug endpoint (backend only).
# Has no effect on the frontend.
# TICKLESS_YOUTUBE_DEBUG=

# Optional: Sentry error tracking for the frontend. NOT WIRED YET - the
# Next.js SDK is not installed, so nothing reads this today. It is listed here
# so the key has a home when @sentry/nextjs lands. The NEXT_PUBLIC_ prefix is
# what would make it reach the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=
